# Application
NODE_ENV=development
LOG_LEVEL=info
APP_NAME=Knoviq
WEB_PORT=3000

# Service ports
AUTH_SERVICE_PORT=4001
AI_GATEWAY_PORT=4002
KNOWLEDGE_SERVICE_PORT=4003
TOOL_EXECUTION_SERVICE_PORT=4004

# Database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=knoviq
POSTGRES_USER=knoviq
POSTGRES_PASSWORD=knoviq_dev_password
DATABASE_URL=postgresql://knoviq:knoviq_dev_password@127.0.0.1:55432/knoviq
DATABASE_SCHEMA=knoviq
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
CACHE_KEY_PREFIX=knoviq
CACHE_DEFAULT_TTL_SECONDS=60
KNOWLEDGE_SEARCH_CACHE_TTL_SECONDS=60
TOOL_DEFINITIONS_CACHE_TTL_SECONDS=300

# Kafka
KAFKA_ENABLED=true
KAFKA_BROKERS=127.0.0.1:29092
KAFKA_CLIENT_ID=knoviq-local
KAFKA_TOPIC_PREFIX=knoviq

# Auth
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ISSUER=knoviq-auth-service
JWT_AUDIENCE=knoviq-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Azure AI Foundry / Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT_FAST=
AZURE_OPENAI_CHAT_DEPLOYMENT_REASONING=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# Knowledge service
# Use "local" only for development smoke tests without Azure credentials.
KNOWLEDGE_EMBEDDING_PROVIDER=azure
KNOWLEDGE_UPLOAD_DIR=./data/uploads
KNOWLEDGE_MAX_FILE_BYTES=10485760
KNOWLEDGE_CHUNK_TARGET_CHARS=1800
KNOWLEDGE_CHUNK_OVERLAP_CHARS=250
KNOWLEDGE_SEARCH_LIMIT=8
KNOWLEDGE_SEARCH_MIN_SIMILARITY=0.2
# Hybrid search + reranking
# KNOWLEDGE_RERANK_CANDIDATES must always be > KNOWLEDGE_SEARCH_LIMIT.
# Rule of thumb: 3-4× KNOWLEDGE_SEARCH_LIMIT.
# Tuning guide: 5=fast/cheap Q&A, 8=balanced default, 10=summarisation, 15+=financial
# Beyond ~15, LLM "lost in the middle" effect reduces answer quality.
KNOWLEDGE_RERANK_CANDIDATES=24
KNOWLEDGE_RERANK_ENABLED=true

# Tool execution service
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:4003
TOOL_DEFAULT_TIMEOUT_MS=30000
TOOL_SQL_MAX_LIMIT=50

# LLM cost controls
AI_GATEWAY_MODEL_PROVIDER=azure
LLM_DEFAULT_MAX_OUTPUT_TOKENS=1200
LLM_MEMORY_MAX_MESSAGES=12
LLM_RATE_LIMIT_MAX_REQUESTS=30
LLM_RATE_LIMIT_WINDOW_SECONDS=60
# Cost estimation fallback - used only when the deployment name does not match any
# known model in the built-in pricing table (packages/observability/src/index.ts).
# Known models (gpt-4o, gpt-4o-mini, text-embedding-3-*) use their own rates
# automatically. Set both to 0 to disable cost recording for unknown deployments.
LLM_PROMPT_COST_PER_1K_TOKENS=0
LLM_COMPLETION_COST_PER_1K_TOKENS=0


# AI gateway
TOOL_EXECUTION_SERVICE_URL=http://127.0.0.1:4004

# Observability
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
